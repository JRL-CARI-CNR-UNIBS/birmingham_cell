<?xml version="1.0" ?>

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="item_model">

  <xacro:arg name="length" default="1" />
  <xacro:property name="length" value="'$(arg length)'" />
  <xacro:arg name="width"  default="1" />
  <xacro:property name="width" value="'$(arg width)'" />
  <xacro:arg name="height" default="1" />
  <xacro:property name="height" value="'$(arg height)'" />


  <link name="item__">
    <inertial>
      <mass value="0.000001" />
      <origin xyz="0 0 0" />
      <inertia  ixx="0.00000001" ixy="0.0"  ixz="0.0"  iyy="0.00000001"  iyz="0.0"  izz="0.00000001" />
    </inertial>
  </link>
  <joint name="the_joint" type="fixed">
    <origin
      xyz="0 0 0"
      rpy="0 0 0" />
    <parent link="item__"/>
    <child link="item"/>
  </joint>
  <link name="item">
    <inertial>
      <mass value="0.0488" />
      <origin xyz="0 0 ${0.029 * height * 1000}" />
      <inertia  ixx="0.00005" ixy="0.0"  ixz="0.0"  iyy="0.00005"  iyz="0.0"  izz="0.0000065" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://birmingham_cell_description/meshes/item.STL" scale="${length} ${width} ${height}"/>
      </geometry>
    </visual>
    <collision concave="true">
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://birmingham_cell_description/meshes/item.STL" scale="${length} ${width} ${height}"/>
      </geometry>
    </collision>
  </link>
</robot>
